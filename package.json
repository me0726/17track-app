{
  "name": "trackbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "preview": "vite preview",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cn": "^0.4.0",
    "concurrently": "latest",
    "electron": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "shadcn": "^4.21.0",
    "tailwind-merge": "latest",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wait-on": "latest",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "3.9.6",
    "typescript": "latest",
    "vite": "latest"
  }
}
